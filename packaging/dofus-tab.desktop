[Desktop Entry]
Type=Application
Name=Dofus-tab
GenericName=Dofus window switcher
Comment=Switch between Dofus client windows with global hotkeys
Exec=dofus-tab daemon
Icon=input-gaming
Terminal=false
Categories=Game;Utility;
Keywords=dofus;multiaccount;window;switcher;
# The desktop portal derives the application identity from the systemd scope of
# the calling process. Launching the daemon through this entry (or through the
# systemd user unit) is what makes the global shortcuts appear under Dofus-tab
# in the desktop settings instead of under the terminal that started it.
StartupNotify=false
NoDisplay=false
